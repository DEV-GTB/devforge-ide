# =====================================================
# DEVFORGE AI - ENVIRONMENT CONFIGURATION
# =====================================================
# SECURITY NOTICE:
# - Never commit actual .env file to version control
# - Never share API keys or secrets
# - Use different keys for development and production
# - Rotate keys regularly
# - Enable IP restrictions where possible
# =====================================================

# =====================================================
# CLOUDFLARE WORKERS AI CONFIGURATION
# =====================================================
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_API_KEY=your_api_key_here

# =====================================================
# GEMINI AI CONFIGURATION (For code explanation and small tasks)
# =====================================================
GEMINI_API_KEY=your_gemini_api_key_here

# =====================================================
# OPTIONAL: LOCAL AI CONFIGURATION (OLLAMA)
# =====================================================
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# =====================================================
# WEB SEARCH CONFIGURATION (for India & Kerala Search)
# =====================================================
# Optional. Without a key, the app still works using Google search links.
# Brave Search API: https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=
# Tavily API (alternative provider): https://tavily.com/
TAVILY_API_KEY=
# Preferred provider when both are set: brave | tavily | links
SEARCH_PROVIDER=

# =====================================================
# OPTIONAL: DATABASE CONFIGURATION
# =====================================================
# SQLite (default - no config needed)
# DATABASE_PATH=./data/devforge.db

# PostgreSQL (optional)
# DATABASE_URL=postgresql://user:password@localhost:5432/devforge

# =====================================================
# SERVER CONFIGURATION
# =====================================================
PORT=3001
NODE_ENV=development
HOST=localhost

# =====================================================
# SECURITY CONFIGURATION
# =====================================================
# JWT Secret for session management (generate a random string)
JWT_SECRET=generate_random_32_char_string_here

# Session encryption key
SESSION_SECRET=generate_random_32_char_string_here

# API Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =====================================================
# WORKSPACE CONFIGURATION
# =====================================================
# Default workspace directory
WORKSPACE_ROOT=./workspaces

# Maximum workspace size (in MB)
MAX_WORKSPACE_SIZE=1024

# Allowed file extensions
ALLOWED_EXTENSIONS=.ts,.tsx,.js,.jsx,.py,.java,.go,.rs,.c,.cpp,.h,.json,.md,.txt,.yaml,.yml,.html,.css,.scss

# =====================================================
# AGENT CONFIGURATION
# =====================================================
# Maximum agent iterations
AGENT_MAX_ITERATIONS=10

# Agent timeout (in milliseconds)
AGENT_TIMEOUT=300000

# Enable auto-approval for safe operations
AGENT_AUTO_APPROVE_SAFE=true

# Require approval for destructive operations
AGENT_REQUIRE_APPROVAL_DESTRUCTIVE=true

# =====================================================
# LOGGING CONFIGURATION
# =====================================================
# Log level: debug, info, warn, error
LOG_LEVEL=info

# Log file path (optional)
LOG_FILE=./logs/devforge.log

# =====================================================
# FEATURE FLAGS
# =====================================================
# Enable/disable features
ENABLE_DEVICE_LAB=true
ENABLE_TERMINAL=true
ENABLE_PREVIEW=true
ENABLE_VISION=false
ENABLE_MULTI_AGENT=false

# =====================================================
# LICENSING CONFIGURATION
# =====================================================
# License key (for commercial use)
LICENSE_KEY=

# License server URL (for validation)
LICENSE_SERVER_URL=

# =====================================================
# ANALYTICS (Optional - Disabled by default)
# =====================================================
ENABLE_ANALYTICS=false
ANALYTICS_ID=

# =====================================================
# DEVELOPMENT ONLY
# =====================================================
# Enable debug mode
DEBUG=false

# Enable hot reload
HOT_RELOAD=true

# ========================================
# END OF CONFIGURATION
# ========================================
